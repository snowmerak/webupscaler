    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "@webgpu/types": "^0.1.71",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wgsl_reflect": "^1.5.0"
  }
}
